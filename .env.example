# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
#
# ── Local development (Supabase CLI / Docker) ──────────────────────────────
# Run `npm run supabase:start`; it prints the URL and the API keys below.
# This CLI version issues NEW-format keys: a "Publishable" key (sb_publishable_…)
# and a "Secret" key (sb_secret_…) — not the legacy anon/service_role JWTs.

# Postgres connection string used by Drizzle + the app (stable local default).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase JS client (browser + server). Stable local default URL.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"

# Publishable key from `supabase start` output (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Secret key from `supabase start` output. SERVER-ONLY — never expose to the
# browser, never put in a NEXT_PUBLIC_* variable. Used for admin actions
# (seeding the first admin, creating users).
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ── Production (Vercel + hosted Supabase) ──────────────────────────────────
# Set these in the Vercel dashboard (do NOT commit real values):
#   DATABASE_URL=postgresql://...pooler.supabase.com:6543/postgres  (pooled)
#   NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key from dashboard>
#   SUPABASE_SERVICE_ROLE_KEY=<secret key from dashboard>

# First admin, created by `npm run seed:admin`. Set real values in .env.local.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-min-8-chars"

# ── MCP server (phase 7) ───────────────────────────────────────────────────
# Static bearer token gating the remote MCP endpoint at /api/mcp. External
# Claude sends it as "Authorization: Bearer <token>". Use a long random secret
# in production; unset = the endpoint returns 503.
MCP_TOKEN="change-me-to-a-long-random-secret"
